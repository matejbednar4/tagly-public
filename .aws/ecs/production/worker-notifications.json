{
  "family": "flaer-prod-workers",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "ephemeralStorage": {
    "sizeInGiB": 21
  },
  "executionRoleArn": "arn:aws:iam::742412930140:role/flaer-prod-workersTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::742412930140:role/flaer-prod-workersTaskRole",
  "containerDefinitions": [
    {
      "name": "worker",
      "image": "742412930140.dkr.ecr.us-east-1.amazonaws.com/flaer-prod-workers:latest",
      "essential": true,
      "cpu": 0,
      "portMappings": [],
      "mountPoints": [],
      "volumesFrom": [],
      "environmentFiles": [],
      "environment": [
        {
          "name": "WORKER",
          "value": "notifications"
        }
      ],
      "secrets": [
        {
          "name": "API_BASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/production/public-iupj0P:API_BASE_URL::"
        },
        {
          "name": "APPLE_OAUTH_CLIENT_IDS",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/production/public-iupj0P:APPLE_OAUTH_CLIENT_IDS::"
        },
        {
          "name": "APP_STAGE",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/production/public-iupj0P:APP_STAGE::"
        },
        {
          "name": "AWS_REGION",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/production/public-iupj0P:AWS_REGION::"
        },
        {
          "name": "CDN_BASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/production/public-iupj0P:CDN_BASE_URL::"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/production-frUMMm:DATABASE_URL::"
        },
        {
          "name": "GOOGLE_OAUTH_CLIENT_IDS",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/production/public-iupj0P:GOOGLE_OAUTH_CLIENT_IDS::"
        },
        {
          "name": "GOOGLE_SAFE_BROWSING_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/production-frUMMm:GOOGLE_SAFE_BROWSING_API_KEY::"
        },
        {
          "name": "IG_CLIENT_ID",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/production/public-iupj0P:IG_CLIENT_ID::"
        },
        {
          "name": "IG_CLIENT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/production-frUMMm:IG_CLIENT_SECRET::"
        },
        {
          "name": "IG_TOKEN_ENC_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/production-frUMMm:IG_TOKEN_ENC_KEY::"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/production-frUMMm:JWT_SECRET::"
        },
        {
          "name": "NOTIFICATION_UNSUBSCRIBE_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/production-frUMMm:NOTIFICATION_UNSUBSCRIBE_SECRET::"
        },
        {
          "name": "PASSWORD_PEPPER",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/production-frUMMm:PASSWORD_PEPPER::"
        },
        {
          "name": "PORT",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/production/public-iupj0P:PORT::"
        },
        {
          "name": "POSTHOG_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/production/public-iupj0P:POSTHOG_API_KEY::"
        },
        {
          "name": "POSTHOG_HOST",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/production/public-iupj0P:POSTHOG_HOST::"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/production/public-iupj0P:REDIS_URL::"
        },
        {
          "name": "RESEND_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/production-frUMMm:RESEND_API_KEY::"
        },
        {
          "name": "RESEND_WEBHOOK_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/production-frUMMm:RESEND_WEBHOOK_SECRET::"
        },
        {
          "name": "S3_BUCKET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/production/public-iupj0P:S3_BUCKET::"
        },
        {
          "name": "STRIPE_API_VERSION_SERVER",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/production/public-iupj0P:STRIPE_API_VERSION_SERVER::"
        },
        {
          "name": "STRIPE_CONNECT_WEBHOOK_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/production-frUMMm:STRIPE_CONNECT_WEBHOOK_SECRET::"
        },
        {
          "name": "STRIPE_PUBLISHABLE_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/production/public-iupj0P:STRIPE_PUBLISHABLE_KEY::"
        },
        {
          "name": "STRIPE_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/production-frUMMm:STRIPE_SECRET_KEY::"
        },
        {
          "name": "STRIPE_WEBHOOK_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/production-frUMMm:STRIPE_WEBHOOK_SECRET::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/flaer-prod-workers",
          "awslogs-create-group": "true",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "tags": [
    {
      "key": "app",
      "value": "tagly"
    },
    {
      "key": "env",
      "value": "production"
    }
  ]
}
