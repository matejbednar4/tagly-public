{
  "family": "flaer-staging-workers",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "ephemeralStorage": {
    "sizeInGiB": 21
  },
  "executionRoleArn": "arn:aws:iam::742412930140:role/FlaerStaging-WorkersTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::742412930140:role/FlaerStaging-WorkersTaskRole",
  "containerDefinitions": [
    {
      "name": "worker",
      "image": "742412930140.dkr.ecr.us-east-1.amazonaws.com/flaer-staging-workers:latest",
      "essential": true,
      "cpu": 0,
      "portMappings": [],
      "mountPoints": [],
      "volumesFrom": [],
      "environmentFiles": [],
      "environment": [
        {
          "name": "WORKER",
          "value": "igSnapshots"
        }
      ],
      "secrets": [
        {
          "name": "API_BASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/staging/public-6yFY3N:API_BASE_URL::"
        },
        {
          "name": "APPLE_OAUTH_CLIENT_IDS",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/staging/public-6yFY3N:APPLE_OAUTH_CLIENT_IDS::"
        },
        {
          "name": "APP_STAGE",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/staging/public-6yFY3N:APP_STAGE::"
        },
        {
          "name": "AWS_REGION",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/staging/public-6yFY3N:AWS_REGION::"
        },
        {
          "name": "CDN_BASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/staging/public-6yFY3N:CDN_BASE_URL::"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/staging-C9pXFk:DATABASE_URL::"
        },
        {
          "name": "GOOGLE_OAUTH_CLIENT_IDS",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/staging/public-6yFY3N:GOOGLE_OAUTH_CLIENT_IDS::"
        },
        {
          "name": "GOOGLE_SAFE_BROWSING_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/staging-C9pXFk:GOOGLE_SAFE_BROWSING_API_KEY::"
        },
        {
          "name": "IG_CLIENT_ID",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/staging/public-6yFY3N:IG_CLIENT_ID::"
        },
        {
          "name": "IG_CLIENT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/staging-C9pXFk:IG_CLIENT_SECRET::"
        },
        {
          "name": "IG_TOKEN_ENC_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/staging-C9pXFk:IG_TOKEN_ENC_KEY::"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/staging-C9pXFk:JWT_SECRET::"
        },
        {
          "name": "NOTIFICATION_UNSUBSCRIBE_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/staging-C9pXFk:NOTIFICATION_UNSUBSCRIBE_SECRET::"
        },
        {
          "name": "PASSWORD_PEPPER",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/staging-C9pXFk:PASSWORD_PEPPER::"
        },
        {
          "name": "PORT",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/staging/public-6yFY3N:PORT::"
        },
        {
          "name": "POSTHOG_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/staging/public-6yFY3N:POSTHOG_API_KEY::"
        },
        {
          "name": "POSTHOG_HOST",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/staging/public-6yFY3N:POSTHOG_HOST::"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/staging/public-6yFY3N:REDIS_URL::"
        },
        {
          "name": "RESEND_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/staging-C9pXFk:RESEND_API_KEY::"
        },
        {
          "name": "RESEND_WEBHOOK_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/staging-C9pXFk:RESEND_WEBHOOK_SECRET::"
        },
        {
          "name": "S3_BUCKET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/staging/public-6yFY3N:S3_BUCKET::"
        },
        {
          "name": "STRIPE_API_VERSION_SERVER",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/staging/public-6yFY3N:STRIPE_API_VERSION_SERVER::"
        },
        {
          "name": "STRIPE_CONNECT_WEBHOOK_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/staging-C9pXFk:STRIPE_CONNECT_WEBHOOK_SECRET::"
        },
        {
          "name": "STRIPE_PUBLISHABLE_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/staging/public-6yFY3N:STRIPE_PUBLISHABLE_KEY::"
        },
        {
          "name": "STRIPE_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/staging-C9pXFk:STRIPE_SECRET_KEY::"
        },
        {
          "name": "STRIPE_WEBHOOK_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:742412930140:secret:flaer/staging-C9pXFk:STRIPE_WEBHOOK_SECRET::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/flaer-staging-workers-cluster",
          "awslogs-create-group": "true",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "tags": [
    {
      "key": "app",
      "value": "tagly"
    },
    {
      "key": "env",
      "value": "staging"
    }
  ]
}
