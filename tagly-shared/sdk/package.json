{
  "name": "@tagly/sdk",
  "description": "Tagly SDK — shared client functions and request utilities for customer and advertiser apps",
  "version": "2.0.2",
  "author": "Flaer, Inc.",
  "private": true,
  "type": "module",

  "main": "src/index.shared.ts",

  "exports": {
    "./shared": {
      "react-native": "./src/index.shared.ts",
      "default": "./src/index.shared.ts"
    },
    "./v2/crossApp": {
      "react-native": "./src/index.v2.crossApp.ts",
      "default": "./src/index.v2.crossApp.ts"
    },
    "./v2/customerApp": {
      "react-native": "./src/index.v2.customerApp.ts",
      "default": "./src/index.v2.customerApp.ts"
    },
    "./v2/advertiserApp": {
      "react-native": "./src/index.v2.advertiserApp.ts",
      "default": "./src/index.v2.advertiserApp.ts"
    },
    "./v2/adminApp": {
      "react-native": "./src/index.v2.adminApp.ts",
      "default": "./src/index.v2.adminApp.ts"
    }
  },

  "files": ["src"],

  "peerDependencies": {
    "@babel/runtime": "*",
    "@tagly/models": "*",
    "zod": "*"
  },

  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3"
  },

  "scripts": {
    "clean": "rm -rf dist"
  }
}