{
  "name": "@tagly/backend",
  "description": "Tagly backend service — Node.js + Express + Prisma + PostgreSQL",
  "version": "2.0.2",
  "author": "Flaer, Inc.",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.749.0",
    "@aws-sdk/client-geo-places": "^3.913.0",
    "@aws-sdk/client-rekognition": "^3.913.0",
    "@aws-sdk/client-s3": "^3.893.0",
    "@aws-sdk/lib-storage": "^3.893.0",
    "@aws-sdk/s3-presigned-post": "^3.893.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@tagly/models": "2.0.2",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@types/cors": "^2.8.19",
    "argon2": "^0.44.0",
    "bcrypt": "^5.1.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.28.7",
    "mime-types": "^3.0.1",
    "morgan": "^1.10.0",
    "nanoid": "^5.1.5",
    "obscenity": "^0.4.6",
    "pg": "^8.16.3",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "posthog-node": "^4.18.0",
    "rate-limit-redis": "^5.0.0",
    "resend": "^4.6.0",
    "sharp": "^0.33.4",
    "stripe": "^19.1.0",
    "tz-lookup": "^6.1.25",
    "xss": "^1.0.15",
    "zod": "^4.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.23",
    "@types/ffprobe-static": "^2.0.3",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mime-types": "^3.0.1",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.15.5",
    "@types/pngjs": "^6.0.5",
    "concurrently": "^10.0.3",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.36.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "fast-glob": "^3.3.3",
    "kysely-codegen": "^0.19.0",
    "nodemon": "^3.1.9",
    "prisma": "^7.0.0",
    "ts-morph": "^27.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.7.3"
  },
  "main": "dist/app.js",
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.0.2",
    "@img/sharp-linux-x64": "0.33.4"
  },
  "private": true,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "build:runner": "yarn run prisma:generate && yarn run build",
    "ensure:redis": "brew services start redis >/dev/null 2>&1 || true",
    "dev": "yarn ensure:redis && nodemon --watch src --ext ts,js --exec tsx src/app.ts",
    "dev:all": "yarn ensure:redis && concurrently -k -n api,hooks,workers -c blue,magenta,green \"nodemon --watch src --ext ts,js --exec tsx src/app.ts\" \"yarn dev:webhooks\" \"yarn dev:workers\"",
    "dev:webhooks": "stripe listen --api-key $(grep '^STRIPE_SECRET_KEY=' .env | cut -d= -f2 | tr -d '\\\"') --forward-to localhost:8080/webhooks/stripe/platform --forward-connect-to localhost:8080/webhooks/stripe/connect",
    "dev:workers": "concurrently -k -n cleanup,maint,notif,igIns,igSnap,pay,stripe \"tsx src/workers/cleanup/run.ts\" \"tsx src/workers/maintenance/run.ts\" \"tsx src/workers/notifications/run.ts\" \"tsx src/workers/igInsights/run.ts\" \"tsx src/workers/igSnapshot/run.ts\" \"tsx src/workers/sharePayment/run.ts\" \"tsx src/workers/stripe/run.ts\"",
    "dev:worker": "tsx src/workers/${WORKER}/run.ts",
    "start:migrate": "yarn run prisma:migrate:deploy && node dist/app.js",
    "db:types": "npx kysely-codegen",
    "fix:imports": "node scripts/add-js-extensions.mjs",
    "gen:index": "node scripts/genIndex.mjs",
    "email:test": "tsx scripts/sendTestEmail.ts",
    "seed": "tsx src/seed/verticals.ts && tsx src/seed/notifications.ts",
    "seed:accounts": "tsx src/seed/dev_fake_data/index.ts"
  },
  "type": "module"
}
