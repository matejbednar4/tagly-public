// A printed physical QR sticker placed in a partner business to onboard
// customers. `stickerId` is the OPAQUE id printed on the sticker, matched
// EXACTLY as printed — no padding/case/numeric normalization ("000001" in
// the current batch, possibly random strings like "yf5h8ayui21r" in future
// batches; shape bounded by `QrStickerIdSchema` in @tagly/models
// core/qrStickers). The same literal string is used in the DB, URLs,
// attribution params, and UI. A row exists iff the sticker hangs in a business:
// assigning creates it, unassigning (sticker physically removed) hard-deletes
// it. One business holds many stickers; a sticker belongs to exactly one.
// Reassignment is delete+recreate, so `createdAt` IS the assignment moment
// (surfaced on the wire as `assignedAt`) — no separate column to drift.
model QrSticker {
  id        Int    @id @default(autoincrement())
  stickerId String @unique @map("sticker_id")

  localId Int             @map("local_id")
  local   LocalSubaccount @relation(fields: [localId], references: [id], onDelete: Cascade)

  note String? // free-text placement note ("table 4", "by the door")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([localId])
  @@map("qr_stickers")
  @@schema("app")
}

// One opening-hours interval for a business, interpreted in the business's
// local timezone (`LocalSubaccount.address.timezone`). The hours are a set of
// these rows:
//   - splits   → multiple rows for the same `dayOfWeek` (e.g. 11:00–14:00 and
//                17:00–22:00)
//   - overnight → `closeMinute <= openMinute` means the interval closes the
//                 next day (e.g. a bar open 17:00 → 02:00 is open=1020, close=120)
//   - 24 hours  → open=0, close=1440
//   - closed    → simply no row for that weekday
// "Open now" is computed by the client from these rows + the business timezone
// (kept off the cached response so it never goes stale).
model OpeningHoursPeriod {
  id      Int             @id @default(autoincrement())
  localId Int             @map("local_id")
  local   LocalSubaccount @relation(fields: [localId], references: [id], onDelete: Cascade)

  dayOfWeek   Int @map("day_of_week") // 0 = Sunday … 6 = Saturday (matches JS Date.getDay)
  openMinute  Int @map("open_minute") // minutes from local midnight, 0–1439
  closeMinute Int @map("close_minute") // minutes from local midnight, 1–1440; <= openMinute ⇒ closes next day

  @@index([localId])
  @@map("opening_hours_periods")
  @@schema("app")
}

enum LinkStatus {
  PENDING // newly submitted, awaiting admin review
  APPROVED // safe + appropriate; the only status returned to customers
  REJECTED // Safe Browsing flagged it, or an admin rejected it

  @@schema("app")
}

// A business-supplied web link (website / menu / reservation). Shared and
// de-duplicated by `url` so each distinct link is reviewed once. New links
// default to PENDING; Google Safe Browsing auto-flags malicious URLs to REJECTED
// at write time; an admin then APPROVES the rest. Only APPROVED links are ever
// returned to customers (the hydrator gates on status), and a REJECTED row acts
// as a central kill-switch across every business that uses that URL.
model Link {
  id     Int        @id @default(autoincrement())
  url    String     @unique
  status LinkStatus @default(PENDING)

  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewedByAdminId Int?      @map("reviewed_by_admin_id")
  reviewedByAdmin   Admin?    @relation(fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  websiteLocals     LocalSubaccount[] @relation("LocalWebsiteLink")
  reservationLocals LocalSubaccount[] @relation("LocalReservationLink")
  menuLocals        LocalSubaccount[] @relation("LocalMenuLink")

  @@index([status])
  @@map("links")
  @@schema("app")
}

