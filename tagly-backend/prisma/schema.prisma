generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
  moduleFormat        = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app", "jobs"]
}

enum MediaType {
  IMAGE
  VIDEO

  @@schema("app")
}

enum OtpPurpose {
  REGISTRATION
  LOGIN
  EMAIL_CHANGE_CURRENT
  EMAIL_CHANGE_NEW
  PASSWORD_RESET
  ACCOUNT_DELETION

  @@schema("app")
}

model OtpSession {
  id      Int        @id @default(autoincrement())
  purpose OtpPurpose

  targetEmail  String    @map("target_email") @db.Citext
  otpHash      String    @map("otp_hash")
  otpExpiresAt DateTime  @map("otp_expires_at") @db.Timestamptz(3)
  attempts     Int       @default(0)
  resendCount  Int       @default(0) @map("resend_count")
  lastSentAt   DateTime? @map("last_sent_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  pendingCustomerId   Int? @unique @map("pending_customer_id")
  pendingAdvertiserId Int? @unique @map("pending_advertiser_id")
  customerId          Int? @map("customer_id")
  advertiserId        Int? @map("advertiser_id")
  adminId             Int? @map("admin_id")

  pendingCustomer   PendingCustomer?          @relation(fields: [pendingCustomerId], references: [id], onDelete: Cascade)
  pendingAdvertiser PendingAdvertiserAccount? @relation(fields: [pendingAdvertiserId], references: [id], onDelete: Cascade)
  customer          Customer?                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  advertiser        Advertiser?               @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  admin             Admin?                    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([purpose, customerId], name: "otpPurposeCustomerId")
  @@unique([purpose, advertiserId], name: "otpPurposeAdvertiserId")
  @@unique([purpose, adminId], name: "otpPurposeAdminId")
  @@index([targetEmail, purpose])
  @@index([otpExpiresAt])
  @@index([customerId, purpose])
  @@index([advertiserId, purpose])
  @@map("otp_sessions")
  @@schema("app")
}

enum AdminRole {
  SUPER
  SUPPORT
  OPS

  @@schema("app")
}

model Admin {
  id  Int    @id @default(autoincrement())
  uid String @unique

  email        String @unique @db.Citext
  username     String @unique
  passwordHash String @map("password_hash")

  isActive Boolean   @default(true) @map("is_active")
  role     AdminRole

  otpSessions       OtpSession[]
  blastLogs         AdminBlastLog[]
  reviewedLinks     Link[]
  setReferralEvents ReferralEvent[]
  jwtVersion        Int             @default(0) @map("jwt_version")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([email])
  @@map("admins")
  @@schema("app")
}

enum PendingMediaPurpose {
  LOCAL_BANNER
  LOCAL_PHOTO

  @@schema("app")
}

model PendingMedia {
  id               Int    @id @default(autoincrement())
  uid              String @unique
  expectedMime     String @map("expected_mime")
  expectedMaxBytes Int    @map("expected_max_bytes")
  bucket           String
  key              String @unique
  width            Int?
  height           Int?
  durationMs       Int?   @map("duration_ms")

  purpose PendingMediaPurpose

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  bannerOfPendingLocal PendingLocalSubaccount? @relation("PendingLocalSubaccountBanner")
  photoOfPendingLocal  PendingLocalSubaccount? @relation("PendingLocalSubaccountPhotos", fields: [pendingLocalId], references: [id], onDelete: SetNull)
  pendingLocalId       Int?                    @map("pending_local_id")

  @@index([key])
  @@index([createdAt])
  @@map("pending_media")
  @@schema("app")
}

model Media {
  id  Int    @id @default(autoincrement())
  uid String @unique

  key         String    @unique
  type        MediaType
  mime        String
  sizeBytes   Int?      @map("size_bytes")
  width       Int
  height      Int
  aspectRatio Float     @map("aspect_ratio")
  durationMs  Int?      @map("duration_ms")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  bannerOfLocal     LocalSubaccount? @relation("LocalSubaccountBanner")
  photoOfLocal      LocalSubaccount? @relation("LocalSubaccountPhotos", fields: [localSubaccountId], references: [id], onDelete: SetNull)
  localSubaccountId Int?             @map("local_subaccount_id")

  usedAsShareMedia     Share? @relation("ShareMainMedia")
  usedAsShareThumbnail Share? @relation("ShareThumbMedia")

  @@index([key])
  @@index([type])
  @@map("media")
  @@schema("app")
}

enum AccountType {
  CUSTOMER
  ADVERTISER
  PENDING_CUSTOMER
  PENDING_ADVERTISER

  @@schema("app")
}

enum AccountReferralStatus {
  ACTIVE
  INACTIVE
  DELETED

  @@schema("app")
}

model AccountReferral {
  id   Int    @id @default(autoincrement())
  code String @unique @db.Citext

  codeUpdatedAt DateTime? @map("code_updated_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  referrerEvents ReferralEvent[] @relation("ReferrerCode")
  referredEvent  ReferralEvent?  @relation("ReferredCode")

  customer   Customer?   @relation(name: "CustomerCode")
  advertiser Advertiser? @relation(name: "AdvertiserCode")

  status AccountReferralStatus @default(ACTIVE)

  @@map("account_referrals")
  @@schema("app")
}

model ReferralEvent {
  id             Int             @id @default(autoincrement())
  referrerCodeId Int             @map("referrer_code_id")
  referrerCode   AccountReferral @relation("ReferrerCode", fields: [referrerCodeId], references: [id], onDelete: Restrict)

  referredCodeId Int             @unique @map("referred_code_id")
  referredCode   AccountReferral @relation("ReferredCode", fields: [referredCodeId], references: [id], onDelete: Restrict)

  /// Audit trail for admin-set referrals: an influencer brings a business, sales
  /// onboards it, and nobody tells the business to enter the code — an admin
  /// links them after the fact via POST /v2/admin/advertisers/:uid/referrer.
  /// Null = the account entered the code itself in-app.
  setByAdminId Int?    @map("set_by_admin_id")
  setByAdmin   Admin?  @relation(fields: [setByAdminId], references: [id], onDelete: SetNull)
  adminReason  String? @map("admin_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("referral_events")
  @@schema("app")
}

model PendingCustomer {
  id    Int    @id @default(autoincrement())
  email String @unique @db.Citext

  // ISO alpha-2 country code (`'US'`, `'CZ'`). Set at signup time from the
  // landing-page suggest-locale signal or hardcoded to `'US'` by old routes.
  locale   String @db.VarChar(2)
  // ISO 639-1 language code (`'en'`, `'cs'`). Used for transactional emails
  // sent during onboarding.
  language String @db.VarChar(5)

  fullName                  String?  @map("full_name") // null until profile step (v2 flow)
  promoNotificationsEnabled Boolean? @map("promo_notifications_enabled") // null until profile step (v2 flow)
  registrationToken         String   @unique @map("registration_token")

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  referrerCode String?  @map("referrer_code")

  agreedToTermsOfServiceAt DateTime? @map("agreed_to_terms_of_service_at") @db.Timestamptz(3) // null until profile step (v2 flow)
  agreedToPrivacyPolicyAt  DateTime? @map("agreed_to_privacy_policy_at") @db.Timestamptz(3) // null until profile step (v2 flow)

  emailVerified Boolean @default(false) @map("email_verified") // set to true after OTP verification (v2 flow)

  instagram             CustomerInstagramAccount?
  gender                Gender? // null until profile step (v2 flow)
  interests             Interest[]
  otpSession            OtpSession?
  pushTokens            PushToken[]
  promoNotificationLogs PromoNotificationLog[]
  oauthIdentities       OAuthIdentity[]

  @@map("pending_customers")
  @@schema("app")
}

enum CustomerStatus {
  ACTIVE
  BANNED

  @@schema("app")
}

model Customer {
  id    Int    @id @default(autoincrement())
  uid   String @unique
  email String @unique @db.Citext

  // ACTIVE customers can use the app normally. BANNED customers can still log
  // in but cannot create shares or withdraw money (gated in the respective
  // controllers). A ban also records the customer's IG in BannedInstagram so
  // the same Instagram cannot be re-used on Tagly.
  status CustomerStatus @default(ACTIVE)

  // ISO alpha-2 country code (`'US'`, `'CZ'`). Copied from PendingCustomer
  // at promote time. Not user-modifiable in v1 — admin tooling fixes
  // mistakes. Drives future segmentation + per-locale rules.
  locale   String @db.VarChar(2)
  // ISO 639-1 language code (`'en'`, `'cs'`). User-modifiable via
  // PATCH /customers/language.
  language String @db.VarChar(5)

  agreedToTermsOfServiceAt DateTime @map("agreed_to_terms_of_service_at") @db.Timestamptz(3)
  agreedToPrivacyPolicyAt  DateTime @map("agreed_to_privacy_policy_at") @db.Timestamptz(3)

  jwtVersion Int @default(0) @map("jwt_version")

  fullName        String                    @map("full_name")
  instagram       CustomerInstagramAccount?
  sensitiveData   CustomerSensitiveData     @relation(name: "CustomerToSensitive", fields: [sensitiveDataId], references: [id], onDelete: Cascade)
  sensitiveDataId Int                       @unique @map("sensitive_data_id")

  shares                    Share[]
  gender                    Gender
  interests                 Interest[]
  pushTokens                PushToken[]
  notificationOptOuts       NotificationEventOptOut[]
  // Self-reported "typical story views" for customers with no usable Instagram
  // data — the reach fallback the v2 estimate pricer reads (E062: server-owned
  // so estimates are a pure function of server state and therefore cacheable;
  // the old per-request query param was removed from the v2 wire). Written ONLY
  // by updateEstimatedStoryViews, which bumps the customer reward-est gen.
  // Null = never provided (or cleared). Ignored once a snapshot exists (real
  // data always wins in the pricer).
  estimatedStoryViews       Int?                                  @map("estimated_story_views")

  promoNotificationsEnabled Boolean                @default(true) @map("promo_notifications_enabled")
  promoNotificationLogs     PromoNotificationLog[]

  genderUpdatedAt    DateTime? @map("gender_updated_at") @db.Timestamptz(3)
  interestsUpdatedAt DateTime? @map("interests_updated_at") @db.Timestamptz(3)

  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  accountReferral   AccountReferral @relation("CustomerCode", fields: [accountReferralId], references: [id], onDelete: Restrict)
  accountReferralId Int             @unique @map("referral_code_id")

  ledgerEvents      TransactionLedgerEvent[] @relation("LedgerCustomer")
  stripeWithdrawals StripeWithdrawal[]
  otpSessions       OtpSession[]
  oauthIdentities   OAuthIdentity[]

  @@index([email])
  @@index([createdAt])
  @@index([uid])
  @@index([sensitiveDataId])
  @@map("customers")
  @@schema("app")
}

// Persistent block-list of Instagram accounts that have been banned. Checked
// wherever an Instagram account is assigned/reassigned to a Tagly account
// (registration + connect/reconnect) so a banned customer cannot re-use the
// same Instagram (e.g. by deleting their account and re-registering). Rows
// outlive the customer record on purpose, hence no FK to Customer.
model BannedInstagram {
  id              Int      @id @default(autoincrement())
  instagramUid    String   @unique @map("instagram_uid")
  reason          String?
  bannedByAdminId Int?     @map("banned_by_admin_id")
  customerUid     String?  @map("customer_uid") // audit pointer; not a FK
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("banned_instagrams")
  @@schema("app")
}

// Append-only registry of every Instagram post id ever attached to a share —
// THE single dedup source for "was this story already monetized?" (E074).
// Deliberately customer-UNLINKED: GDPR/Meta erasure nulls `Share.igPostId` on
// paid rows, and this table lets the once-only rule survive that de-link
// without keeping a customer-linkable post id anywhere. Written in the same
// transaction as share creation (PK conflict → 1013 already-shared — the
// insert IS the dedup check); backfilled from `shares.ig_post_id` in its
// migration. Rows are NEVER deleted: a story is monetizable once, ever, even
// if its share was voided or rejected (Matej, 2026-08-02 — the old
// "disconnect frees the story for re-share" docblock was wrong; no code may
// re-derive dedup from `Share.igPostId`, which stays as an operational column
// for the insights worker + admin display).
model MonetizedInstagramPost {
  igPostId  String   @id @map("ig_post_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("monetized_instagram_posts")
  @@schema("app")
}

enum Gender {
  MALE
  FEMALE
  UNSPECIFIED

  @@schema("app")
}

model CustomerSensitiveData {
  id Int @id @default(autoincrement())

  // Per-currency balance accumulators. Each currency gets its own pair of
  // columns so accounts can natively hold multiple currencies as the platform
  // expands. Adding a currency = additive migration, no FX conversion of
  // existing balances.
  balanceUsdCents       BigInt @default(0) @map("balance_usd_cents")
  lockedBalanceUsdCents BigInt @default(0) @map("locked_balance_usd_cents")
  multiplierBps         Int    @default(10000) @map("multiplier_bps") // in basis points (10000 = 1.0x)

  stripeConnectId  String?   @map("stripe_connect_id")
  payoutsEnabledAt DateTime? @map("payouts_enabled_at") @db.Timestamptz(3)

  customer Customer? @relation(name: "CustomerToSensitive")

  @@map("customer_sensitive_data")
  @@schema("app")
}

model PushToken {
  id         Int       @id @default(autoincrement())
  token      String    @unique
  platform   String?
  deviceId   String?   @map("device_id")
  timezone   String?
  disabledAt DateTime? @map("disabled_at") @db.Timestamptz(3)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)

  customerId          Int? @map("customer_id")
  advertiserId        Int? @map("advertiser_id")
  pendingCustomerId   Int? @map("pending_customer_id")
  pendingAdvertiserId Int? @map("pending_advertiser_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer          Customer?                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  advertiser        Advertiser?               @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  pendingCustomer   PendingCustomer?          @relation(fields: [pendingCustomerId], references: [id], onDelete: Cascade)
  pendingAdvertiser PendingAdvertiserAccount? @relation(fields: [pendingAdvertiserId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([advertiserId])
  @@index([pendingCustomerId])
  @@index([pendingAdvertiserId])
  @@index([disabledAt])
  @@map("push_tokens")
  @@schema("app")
}

model CustomerInstagramAccount {
  id                Int  @id @default(autoincrement())
  customerId        Int? @unique
  pendingCustomerId Int? @unique

  // The Instagram platform user id — the canonical (and only) home. Every
  // CustomerInstagramAccount row exists because IG was linked, so this is
  // required. Looked up directly for IG login, webhooks, and Graph API calls.
  instagramUid String @unique @map("instagram_uid")

  username      String
  name          String?
  pfpUrl        String? @map("pfp_url")
  followerCount Int     @map("follower_count")
  accountType   String  @map("account_type")

  instagramToken InstagramToken?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  snapshots InstagramSnapshot[]

  pendingCustomer PendingCustomer?         @relation(fields: [pendingCustomerId], references: [id], onDelete: SetNull)
  customer        Customer?                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  snapshotQueues  InstagramSnapshotQueue[]

  @@index([username])
  @@map("customer_instagram_accounts")
  @@schema("app")
}

enum OAuthProvider {
  GOOGLE
  APPLE

  @@schema("app")
}

// Which account namespace an OAuth identity belongs to. The customer and
// advertiser apps are separate sign-in namespaces — the same person can hold
// both a customer and an advertiser account (same email, even the same Google/
// Apple identity) — so identity uniqueness is scoped per-kind, not globally.
enum OAuthAccountKind {
  CUSTOMER
  ADVERTISER

  @@schema("app")
}

// A federated sign-in identity (Google / Apple) linked to a customer OR
// advertiser account. One table for both, mirroring OtpSession's multi-FK
// shape: an identity attaches to a pending account during onboarding and
// migrates to the real account on promotion (like push tokens). An account can
// hold several identities (e.g. Google + Apple + email).
//
// `subject` is the provider's stable `sub` — the canonical login key (Apple
// only returns the email on the FIRST authorization, so repeat logins match on
// the identity, not email). `kind` scopes uniqueness: the same Google/Apple
// identity can map to at most one customer AND one advertiser, independently.
model OAuthIdentity {
  id       Int              @id @default(autoincrement())
  provider OAuthProvider
  subject  String // provider 'sub' — stable across logins
  kind     OAuthAccountKind
  email    String?          @db.Citext // email at link time (Apple relay possible)

  customerId          Int? @map("customer_id")
  pendingCustomerId   Int? @map("pending_customer_id")
  advertiserId        Int? @map("advertiser_id")
  pendingAdvertiserId Int? @map("pending_advertiser_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  customer          Customer?                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pendingCustomer   PendingCustomer?          @relation(fields: [pendingCustomerId], references: [id], onDelete: Cascade)
  advertiser        Advertiser?               @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  pendingAdvertiser PendingAdvertiserAccount? @relation(fields: [pendingAdvertiserId], references: [id], onDelete: Cascade)

  @@unique([provider, subject, kind])
  @@index([customerId])
  @@index([pendingCustomerId])
  @@index([advertiserId])
  @@index([pendingAdvertiserId])
  @@map("oauth_identities")
  @@schema("app")
}

model InstagramToken {
  id          Int @id @default(autoincrement())
  instagramId Int @unique @map("instagram_id")

  accessTokenEnc String @map("access_token_enc")

  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  instagram CustomerInstagramAccount @relation(fields: [instagramId], references: [id], onDelete: Cascade)

  @@index([instagramId])
  @@index([expiresAt])
  @@map("instagram_tokens")
  @@schema("app")
}

enum AudienceLocationSource {
  FOLLOWER_AUDIENCE
  REACHED_AUDIENCE

  @@schema("app")
}

model InstagramAudienceLocation {
  id       Int                                   @id @default(autoincrement())
  address  String
  location Unsupported("geography(Point,4326)")?
  value    Int
  source   AudienceLocationSource

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  snapshot   InstagramSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  snapshotId Int               @map("snapshot_id")

  @@unique([snapshotId, source, address])
  @@index([snapshotId, source])
  @@index([snapshotId])
  @@index([location], type: Gist)
  @@index([address])
  @@map("instagram_audience_location")
  @@schema("app")
}

model InstagramAudienceGenderAge {
  id     Int    @id @default(autoincrement())
  gender String
  age    String
  value  Int

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  snapshot   InstagramSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  snapshotId Int               @map("snapshot_id")

  @@unique([snapshotId, gender, age])
  @@index([snapshotId])
  @@index([gender, age])
  @@map("instagram_audience_gender_age")
  @@schema("app")
}

model Address {
  id          Int                                   @id @default(autoincrement())
  country     String
  countryCode String                                @map("country_code") @db.VarChar(2) // ISO alpha-2 from the geocoder — single source of truth (drives future currency derivation)
  region      String?
  city        String
  zip         String
  street      String
  location    Unsupported("geography(Point,4326)")?

  // IANA timezone (e.g. "America/New_York"), derived from `location` at write
  // time via `getTimezoneForCoordinates`. Drives local-time features such as a
  // business's "open now" computation from its opening-hours periods.
  timezone String

  cityLocation Unsupported("geography(Point,4326)")? @map("city_location") // centroid of (city, region, country) – for calculating distance multipliers

  localSubaccount        LocalSubaccount?        @relation(name: "LocalSubaccountToAddress")
  pendingLocalSubaccount PendingLocalSubaccount? @relation(name: "PendingLocalSubaccountToAddress")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([location], type: Gist)
  @@index([cityLocation], type: Gist)
  @@index([city])
  @@index([zip])
  @@map("addresses")
  @@schema("app")
}

model PendingAdvertiserAccount {
  id                        Int      @id @default(autoincrement())
  email                     String   @unique @db.Citext
  promoNotificationsEnabled Boolean? @map("promo_notifications_enabled") // null until OTP step (v2 flow)

  // ISO alpha-2 country code + ISO 639-1 language code. Set at signup time
  // from the landing-page suggest-locale signal or hardcoded to `'US'`/`'en'`
  // by the v1 route.
  locale   String @db.VarChar(2)
  language String @db.VarChar(5)

  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  referrerCode String?           @map("referrer_code")
  entity       AdvertiserEntity?

  agreedToTermsOfServiceAt DateTime? @map("agreed_to_terms_of_service_at") @db.Timestamptz(3) // null until OTP step (v2 flow)
  agreedToPrivacyPolicyAt  DateTime? @map("agreed_to_privacy_policy_at") @db.Timestamptz(3) // null until OTP step (v2 flow)

  registrationToken String          @unique @map("registration_token") // pending-account token: resume onboarding + cancel/delete the pending account
  emailVerified     Boolean         @default(false) @map("email_verified") // set to true after OTP verification / OAuth (v2 flow)
  otpSession        OtpSession?
  oauthIdentities   OAuthIdentity[]
  pushTokens        PushToken[]

  promoNotificationLogs PromoNotificationLog[]

  @@index([createdAt])
  @@index([email])
  @@map("pending_advertiser_accounts")
  @@schema("app")
}

model Advertiser {
  id              Int    @id @default(autoincrement())
  uid             String @unique
  email           String @unique @db.Citext
  sensitiveDataId Int    @unique @map("sensitive_data_id")

  // ISO alpha-2 country code (`'US'`, `'CZ'`). Copied from
  // PendingAdvertiserAccount at promote time. Not user-modifiable in v1.
  locale   String @db.VarChar(2)
  // ISO 639-1 language code (`'en'`, `'cs'`). User-modifiable via
  // PATCH /advertisers/language.
  language String @db.VarChar(5)

  agreedToTermsOfServiceAt DateTime @map("agreed_to_terms_of_service_at") @db.Timestamptz(3)
  agreedToPrivacyPolicyAt  DateTime @map("agreed_to_privacy_policy_at") @db.Timestamptz(3)

  jwtVersion Int @default(0) @map("jwt_version")

  entity AdvertiserEntity?

  sensitiveData AdvertiserSensitiveData @relation(name: "AdvertiserToSensitive", fields: [sensitiveDataId], references: [id], onDelete: Cascade)

