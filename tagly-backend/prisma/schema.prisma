// Transactional notifications only — categories, events, preferences, and the send queue.
// Promo/marketing notifications (pc.promo.*, c.promo.*) are NOT stored here.
// Promo eligibility is gated by promoNotificationsEnabled on each recipient model — not by preference rows.
// Promo events exist only in the in-memory promoCatalog.

// a single event e.g. shares.created or balance.creditPurchaseSuccessful
model NotificationEvent {
  // Display labels + descriptions live only in the shared catalog
  // (@tagly/models notificationEventsCatalog) — DB stores slug + structural
  // fields only.
  id                Int                   @id @default(autoincrement())
  target            AccountType
  mandatoryChannels NotificationChannel[] @map("mandatory_channels")

  slug String @unique

  categoryId        Int                   @map("category_id")
  category          NotificationCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  availableChannels NotificationChannel[] @map("available_channels")

  status    NotificationEventStatus @default(ACTIVE)
  createdAt DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt DateTime                @updatedAt @db.Timestamptz(3)

  sortOrder Int? @map("sort_order")

  optOuts     NotificationEventOptOut[]

  @@index([slug])
  @@index([target])
  @@map("notification_events")
  @@schema("app")
}

// where to send the notifications
enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL

  @@schema("app")
}

// One opt-out row per (account, event): the channels that account turned OFF for
// that event. A missing row (or empty `disabledChannels`) means every available
// channel is ON — new catalog events are on-by-default for everyone, with no
// backfill mechanism (this replaces the versioned opt-in seeding that
// `NOTIFICATION_CATALOG_UPDATED_AT` used to gate). Merged customer+advertiser
// table (PushToken pattern): exactly ONE owner FK is set — enforced by a DB
// CHECK constraint (hand-added in the migration; Prisma can't express it) — and
// the event's `target` keeps each account type scoped to its own events at
// query time.
model NotificationEventOptOut {
  id               Int                   @id @default(autoincrement())
  customerId       Int?                  @map("customer_id")
  advertiserId     Int?                  @map("advertiser_id")
  eventId          Int                   @map("event_id")
  disabledChannels NotificationChannel[] @map("disabled_channels")

  customer   Customer?         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  advertiser Advertiser?       @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  event      NotificationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([customerId, eventId])
  @@unique([advertiserId, eventId])
  @@index([eventId])
  @@map("notification_event_opt_outs")
  @@schema("app")
}

// Lightweight audit log written after each successful notification send.

enum JobStatus {
  SCHEDULED
  PROCESSING
  DONE
  FAILED

  @@schema("jobs")
}

model InstagramInsightsQueue {
  id      Int @id @default(autoincrement())
  shareId Int @unique @map("share_id")

  scheduledAt        DateTime  @map("scheduled_at") @db.Timestamptz(3)
  validUntil         DateTime? @map("valid_until") @db.Timestamptz(3) // story job is only valid 24 hours after the story went live
  status             JobStatus @default(SCHEDULED)
  startedAt          DateTime? @map("started_at") @db.Timestamptz(3)
  processingDeadline DateTime? @map("processing_deadline") @db.Timestamptz(3)
  finishedAt         DateTime? @map("finished_at") @db.Timestamptz(3)

  attempts  Int     @default(0)
  lastError String? @map("last_error")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  share Share @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@index([status, finishedAt])
  @@index([status, updatedAt])
  @@index([status, scheduledAt])
  @@index([status, processingDeadline])
  @@map("instagram_insights_queue")
  @@schema("jobs")
}

model InstagramSnapshotQueue {
  id          Int  @id @default(autoincrement())
  instagramId Int  @map("instagram_id")
  shareId     Int? @unique @map("share_id")

  scheduledAt        DateTime  @map("scheduled_at") @db.Timestamptz(3)
  status             JobStatus @default(SCHEDULED)
  startedAt          DateTime? @map("started_at") @db.Timestamptz(3)
  processingDeadline DateTime? @map("processing_deadline") @db.Timestamptz(3)
  finishedAt         DateTime? @map("finished_at") @db.Timestamptz(3)

  attempts  Int     @default(0)
  lastError String? @map("last_error")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  share     Share?                   @relation(fields: [shareId], references: [id], onDelete: Cascade)
  instagram CustomerInstagramAccount @relation(fields: [instagramId], references: [id], onDelete: Cascade)

  @@index([status, finishedAt])
  @@index([status, updatedAt])
  @@index([status, scheduledAt])
  @@index([status, scheduledAt, id])
  @@index([instagramId, status])
  @@index([status, processingDeadline])
  @@map("instagram_snapshot_queue")
  @@schema("jobs")
}

model NotificationQueue {
  id             Int         @id @default(autoincrement())
  target         AccountType
  recipientId    Int         @map("recipient_id")
  overwriteEmail String?     @map("overwrite_email")

  // Catalog slug — works for both transactional and promo events.
  // No FK to NotificationEvent: promo events are catalog-only and have no DB rows.
  eventSlug String              @map("event_slug")
  channel   NotificationChannel
  payload   Json? // e.g. { "shareId": 123, "balanceChange": 5000 }
  dedupeKey String?             @map("dedupe_key")

  scheduledAt        DateTime  @default(now()) @map("scheduled_at") @db.Timestamptz(3)
  status             JobStatus @default(SCHEDULED)
  startedAt          DateTime? @map("started_at") @db.Timestamptz(3)
  processingDeadline DateTime? @map("processing_deadline") @db.Timestamptz(3)
  finishedAt         DateTime? @map("finished_at") @db.Timestamptz(3)

  attempts  Int     @default(0)
  lastError String? @map("last_error")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([target, recipientId, eventSlug, channel, dedupeKey])
  @@index([status, scheduledAt])
  @@index([status, finishedAt])
  @@index([status, updatedAt])
  @@index([status, processingDeadline])
  @@index([recipientId, eventSlug, channel])
  @@map("notification_queue")
  @@schema("jobs")
}

// Permanent record of every successfully sent promo notification.
// Written by the notification worker after a successful send.
// Read by the maintenance scheduling helpers to skip already-notified recipients,
// preventing re-queuing on every maintenance run while a recipient is inside a cadence window.
model PromoNotificationLog {
  id        Int                 @id @default(autoincrement())
  eventSlug String              @map("event_slug")
  channel   NotificationChannel
  sentAt    DateTime            @default(now()) @map("sent_at") @db.Timestamptz(3)

  customerId          Int? @map("customer_id")
  pendingCustomerId   Int? @map("pending_customer_id")
  advertiserId        Int? @map("advertiser_id")
  pendingAdvertiserId Int? @map("pending_advertiser_id")

  customer          Customer?                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pendingCustomer   PendingCustomer?          @relation(fields: [pendingCustomerId], references: [id], onDelete: Cascade)
  advertiser        Advertiser?               @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  pendingAdvertiser PendingAdvertiserAccount? @relation(fields: [pendingAdvertiserId], references: [id], onDelete: Cascade)

  // One row per slug + channel per recipient — prevents resending the same channel on retry
  @@unique([customerId, eventSlug, channel])
  @@unique([pendingCustomerId, eventSlug, channel])
  @@unique([advertiserId, eventSlug, channel])
  @@unique([pendingAdvertiserId, eventSlug, channel])
  // Scheduling helpers filter by eventSlug only (any channel logged = step done)
  @@index([customerId, eventSlug])
  @@index([pendingCustomerId, eventSlug])
  @@index([advertiserId, eventSlug])
  @@index([pendingAdvertiserId, eventSlug])
  @@map("promo_notification_logs")
  @@schema("app")
}

// Which recipients an admin blast reaches. PROMO_OPTED_IN filters to explicit
// promo consent (the E056 strict-true rule); EVERYONE is reserved for
// OPERATIONAL service announcements (rebrand, policy, incident) sent on the
// legitimate-interest basis — never marketing content (see adminCatalog.ts).
enum BlastAudience {
  PROMO_OPTED_IN
  EVERYONE

  @@schema("app")
}

// Permanent record of every admin-initiated notification blast.
// Written by the v2 adminSendBlast after queue rows are created.
// dedupeKey links back to the NotificationQueue rows for that blast.
// (Retired 2026-08-02 as E050, revived 2026-08-13 with the v2 blast endpoint —
// `slug` + `audience` are nullable because v1-era rows predate them.)
model AdminBlastLog {
  id  Int    @id @default(autoincrement())
  uid String @unique @map("uid")

  adminId Int   @map("admin_id")
  admin   Admin @relation(fields: [adminId], references: [id])

  // Admin-chosen kebab-case identifier for tracking: embedded in the push
  // payload slug (`admin.blast:<slug>` → the apps' `push_opened`
  // PostHog event) and stamped as the `blast` Resend tag on the email leg.
  slug     String?        @map("slug")
  audience BlastAudience? @map("audience")

  // Full per-language content, `{ push?: { en, cs? }, email?: { en, cs? } }` —
  // the same shape the queue payload carries. The flat columns below hold the
  // EN variant for quick scanning; this is the complete record.
  content Json? @map("content")

  // Sending-domain override for the email leg (e.g. "mail.flaer.app"): the
  // literal Resend-verified domain the admin picked, verified against
  // `resend.domains.list()` at enqueue time. Null = the default marketing
  // sender was used (and on v1-era rows, which predate the choice).
  senderDomain String? @map("sender_domain")

  targets  String[] @map("targets")
  channels String[] @map("channels")

  pushTitle String? @map("push_title")
  pushBody  String? @map("push_body")

  emailSubject   String? @map("email_subject")
  emailBody      String? @map("email_body")
  emailTitle     String? @map("email_title")
  emailPreheader String? @map("email_preheader")
  ctaLabel       String? @map("cta_label")
  ctaUrl         String? @map("cta_url")

  queuedCount Int    @map("queued_count")
  dedupeKey   String @unique @map("dedupe_key")

  sentAt    DateTime @default(now()) @map("sent_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("admin_blast_logs")
  @@schema("app")
}
