  promoNotificationLogs PromoNotificationLog[]

  shares                Share[]
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  accountReferralId     Int                    @unique @map("referral_code_id")
  accountReferral       AccountReferral        @relation("AdvertiserCode", fields: [accountReferralId], references: [id], onDelete: Restrict)
  stripeCreditPurchases StripeCreditPurchase[]
  otpSessions           OtpSession[]
  paygPeriods           PaygPeriod[]
