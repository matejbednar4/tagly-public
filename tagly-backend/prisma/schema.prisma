  PENDING // not yet resolved
  VALID // valid report - decrease rating
  DISMISSED // invalid report - keep rating

  @@schema("app")
}

enum TransactionKind {
  CREDIT_PURCHASE // money added to advertiser budget (initial purchase)
  CREDIT_PURCHASE_REFUND // money returned from advertiser budget back to Stripe/card
  CREDIT_PURCHASE_REFUND_LOCK // reserve refund amount from available budget when admin initiates refund
  CREDIT_PURCHASE_REFUND_UNLOCK // release reserved refund amount back to available if Stripe refund fails
  WITHDRAWAL_LOCK // reserve withdrawal amount from customer balance
  WITHDRAWAL_UNLOCK // release reserved withdrawal amount back to customer balance when withdrawal fails
  WITHDRAWAL
  WITHDRAWAL_REVERSAL
  SHARE_LOCK // reserve share price from advertiser budget
  SHARE_UNLOCK // release reserved share price back to advertiser budget when it was cheaper than estimated
  SHARE_PAYMENT
  PAYG_CHARGE // pay-as-you-go: advertiser card charged to fund a share at settlement (card -> advertiser budget, share-scoped)
  STRIPE_PROCESSING_FEE // @deprecated No longer booked — the fee is implicit in the live Stripe balance. Kept only so existing historical rows stay readable.
  REFERRAL_PAYOUT
  PROMOTIONAL_CREDIT // admin-assigned promotional credit from platform revenue
  ADJUSTMENT

  @@schema("app")
}

//
// IMPORTANT
// NEVER CREATE A LEDGER EVENT DIRECTLY - ALWAYS USE THE createLedgerEvent UTIL
//
model TransactionLedgerEvent {
  id       Int             @id @default(autoincrement())
  kind     TransactionKind
  currency String          @db.VarChar(3)

  advertiserId               Int?        @map("advertiser_id")
  advertiser                 Advertiser? @relation("LedgerAdvertiser", fields: [advertiserId], references: [id], onDelete: SetNull)
  deltaAdvertiserCents       BigInt      @default(0) @map("delta_advertiser_cents") // + increases advertiser.availableBudgetCents
  deltaAdvertiserLockedCents BigInt      @default(0) @map("delta_advertiser_locked_cents") // + increases advertiser.lockedBudgetCents

  customerId               Int?      @map("customer_id")
  customer                 Customer? @relation("LedgerCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  deltaCustomerCents       BigInt    @default(0) @map("delta_customer_cents") // + increases customer.balanceCents
  deltaCustomerLockedCents BigInt    @default(0) @map("delta_customer_locked_cents") // + increases customer.lockedBalanceCents

  shareId              Int?    @map("share_id") // which share this ledger event is associated with (if any) 
  share                Share?  @relation("LedgerShare", fields: [shareId], references: [id], onDelete: SetNull)
  grossSharePriceCents BigInt? // what the advertiser paid for the share - before Tagly cut and referrals

  deltaPlatformCents       BigInt @default(0) @map("delta_platform_cents") // + increases Tagly platform balance
  deltaPlatformLockedCents BigInt @default(0) @map("delta_platform_locked_cents") // + increases Tagly locked balance (reserved for in-flight subsidized shares)

  // Idempotency & traceability
  externalRef String?  @map("external_ref") // stripe session ID, stripe transaction ID, etc.
  meta        Json? // e.g. PlatformTakeBPS: 3000 etc.
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  stripeCreditPurchaseId Int?                  @map("stripe_credit_purchase_id")
  stripeCreditPurchase   StripeCreditPurchase? @relation(fields: [stripeCreditPurchaseId], references: [id], onDelete: SetNull)
  stripeWithdrawalId     Int?                  @map("stripe_withdrawal_id")
  stripeWithdrawal       StripeWithdrawal?     @relation(fields: [stripeWithdrawalId], references: [id], onDelete: SetNull)

  @@unique([externalRef, kind])
  @@index([customerId, createdAt])
  @@index([advertiserId, createdAt])
  @@index([kind, createdAt])
  @@index([advertiserId])
  @@index([customerId])
  @@map("transaction_ledger_events")
  @@schema("app")
}

// Singleton table (always exactly one row, id = 1).
// Tracks how many cents are currently locked for in-flight subsidized shares.
// Each currency gets its own column (additive when CZK lands).
// At share creation: net available = live Stripe balance - lockedUsdCents.
// Never modified directly — always via ledger event wrappers.
model PlatformBalance {
  id             Int    @id @default(autoincrement())
  lockedUsdCents BigInt @default(0) @map("locked_usd_cents")

  @@map("platform_balance")
  @@schema("app")
}

enum WithdrawalStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELED
  REVERSED

  @@schema("app")
}

// Payout lifecycle, tracked separately from the ledger `status` (see withdrawals.md).
// The payout (connect account -> bank) can fail/cancel and be retried without the
// ledger-side status changing; `stripePayoutId` always refers to the LATEST attempt.
enum WithdrawalPayoutStatus {
  NONE // no payout created yet
  IN_FLIGHT // payouts.create succeeded; Stripe pending/in_transit
  PAID // payout.paid - money reached the bank
  FAILED // payout.failed - funds returned to the Connect balance
  CANCELED // payout.canceled - money-wise identical to FAILED

  @@schema("app")
}

enum WithdrawalPurpose {
  CUSTOMER_WITHDRAWAL
  ACCOUNT_DELETION_SWEEP

  @@schema("app")
}

model StripeWithdrawal {
  id         Int    @id @default(autoincrement())
  uid        String @unique
  customerId Int?   @map("customer_id")

  currency    String @db.VarChar(3)
  amountCents BigInt @map("amount_cents")

  stripeTransferId String? @unique
  stripePayoutId   String? @map("stripe_payout_id") // latest payout attempt
  instant          Boolean @default(false) // legacy (instant payouts dropped); not on the v2 wire

  // status = the LEDGER summary only (PENDING: money left the balance, unresolved;
  // FAILED: transfer failed, nothing left; COMPLETED: payout PAID; REVERSED: fully
  // clawed back). Payout-leg state lives in payoutStatus. Only the transition
  // helpers in utils/money/withdrawals/withdrawalTransitions.ts may
  // write status / payoutStatus / failure* / settledAt / payoutAttempts /
  // nextPayoutRetryAt / stripePayoutId.
  status         WithdrawalStatus @default(PENDING)
  failureCode    String?          @map("failure_code")
  failureMessage String?          @map("failure_message")

  // Reconciliation is self-sufficient: the connected account + purpose live on the
  // row (the customer row may be deleted - sweeps), and settledAt marks the
  // WITHDRAWAL settle ledger event having committed (gates payout creation).
  stripeAccountId   String?                @map("stripe_account_id")
  purpose           WithdrawalPurpose      @default(CUSTOMER_WITHDRAWAL)
  settledAt         DateTime?              @map("settled_at") @db.Timestamptz(3)
  payoutStatus      WithdrawalPayoutStatus @default(NONE) @map("payout_status")
  payoutAttempts    Int                    @default(0) @map("payout_attempts")
  nextPayoutRetryAt DateTime?              @map("next_payout_retry_at") @db.Timestamptz(3)
  reversedCents     BigInt                 @default(0) @map("reversed_cents")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ledgerEvents TransactionLedgerEvent[]
  customer     Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([stripePayoutId])
  @@index([stripeTransferId])
  @@index([status, payoutStatus])
  @@map("stripe_withdrawals")
  @@schema("app")
}

enum CreditPurchaseStatus {
  PENDING
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
  CANCELED

  @@schema("app")
}

// Discriminates the two things a StripeCreditPurchase row can represent:
// a prepaid credit top-up vs a PAYG off-session settlement charge. PAYG
// charges are non-refundable (the money flowed straight through to a payout),
// so refund paths gate on this.
enum CreditPurchaseKind {
  CREDIT_PURCHASE
  PAYG_CHARGE

  @@schema("app")
}

model StripeCreditPurchase {
  id           Int    @id @default(autoincrement())
  uid          String @unique
  advertiserId Int?   @map("advertiser_id")
  // CREDIT_PURCHASE (prepaid top-up) or PAYG_CHARGE (off-session settlement
  // charge). PAYG charges are non-refundable; refund paths reject them.

  kind CreditPurchaseKind

  currency           String  @db.VarChar(3)
  // Gross amount charged to the card.
  // For regular credit purchases this equals the amount the advertiser chose to add.
  // For PAYG off-session charges this equals the share shortfall plus paygSurchargeCents.
  amountCents        BigInt  @map("amount_cents")
  // PAYG only: fixed per-charge surcharge passed to the advertiser to offset Stripe's
  // per-transaction fee. Null for regular credit purchases.
  paygSurchargeCents BigInt? @map("payg_surcharge_cents")

  stripeCheckoutSessionId String? @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String? @unique @map("stripe_payment_intent_id")
  stripeChargeId          String? @map("stripe_charge_id")

  // PAYG only: durable per-(share, attempt) identity for an off-session
  // settlement charge — the SAME string as the Stripe idempotency key
  // (`payg-share:{shareId}:attempt:{n}:v1`), so the row ↔ Stripe request is
  // 1:1. `chargeAdvertiserCardOffSession` finds-or-creates the row by this ref
  // and reuses its uid + amount, making the retried request byte-identical
  // (Stripe replays instead of raising idempotency_error), and
  // `settlePaygShare`'s recovery pre-pass books any prior collected charge
  // found via this ref before deciding whether to charge again. Null for
  // checkout-session credit purchases.
  externalRef String? @unique @map("external_ref")

  status         CreditPurchaseStatus @default(PENDING)
  failureCode    String?              @map("failure_code")
  failureMessage String?              @map("failure_message")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  reconcileAttempts      Int       @default(0) @map("reconcile_attempts")
  lastReconcileAttemptAt DateTime? @map("last_reconcile_attempt_at") @db.Timestamptz(3)
  nextReconcileAt        DateTime? @default(now()) @map("next_reconcile_at") @db.Timestamptz(3)

  ledgerEvents TransactionLedgerEvent[]
  advertiser   Advertiser?              @relation(fields: [advertiserId], references: [id], onDelete: SetNull)

  @@index([advertiserId, createdAt])
  @@index([stripePaymentIntentId])
  @@index([stripeChargeId])
  @@index([stripeCheckoutSessionId])
  @@index([status, nextReconcileAt])
  @@map("stripe_credit_purchases")
  @@schema("app")
}

// to not process the same stripe event multiple times
model StripeEvent {
  id        Int      @id @default(autoincrement())
  eventId   String   @unique
  type      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("stripe_events")
  @@schema("app")
}

