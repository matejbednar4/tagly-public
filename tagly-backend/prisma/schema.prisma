enum ShareStatus {
  // Payout lifecycle only (collapsed in v2.0.0). A share is born PROCESSING and
  // only a successful payout or a permanent payout failure moves it. Rejection is
  // NOT a status — it lives on approvalStatus (intake) + the ShareReport row.
  PROCESSING // in flight / nothing terminal has happened (born here)
  PAID // payment complete (terminal)
  UNPAYABLE // permanent payout failure - customer/advertiser deleted, insights expired, etc. (terminal)

  @@schema("app")
}

// How a share is funded. CREDITS = advertiser pre-purchased balance,
// PAYG = advertiser card charged at settlement, SUBSIDIZED = platform-funded.
enum ShareFundingMode {
  CREDITS
  PAYG
  SUBSIDIZED

  @@schema("app")
}

// Admin moderation gate for a share, orthogonal to the payout `status` — the
// intake decision, set once. PENDING = awaiting admin review (invisible to the
// advertiser, budget not locked, not notified); APPROVED = cleared for the normal
// lifecycle (lock placed, advertiser notified, payable); REJECTED = bad share,
// never paid. Rejection lives ONLY here (status stays PROCESSING). A post-approval
// report that is upheld is recorded on the ShareReport row (status VALID), not here.
enum ShareApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("app")
}

model Share {
  id  Int    @id @default(autoincrement())
  uid String @unique

  customerId   Int? @map("customer_id")
  advertiserId Int? @map("advertiser_id")
  localId      Int? @map("local_id")

  agreedToTermsOfMonetizationAt DateTime @map("agreed_to_monetization_terms_at") @db.Timestamptz(3)

  mediaId      Int         @unique @map("media_id")
  thumbnailId  Int?        @unique @map("thumbnail_id")
  igPostId     String?     @unique @map("ig_post_id")
  igPostType   IgPostType? @map("ig_post_type")
  postedToIgAt DateTime?   @map("posted_to_ig_at") @db.Timestamptz(3)

  estimatedPriceCents   BigInt      @map("estimated_price_cents")
  estimatedRewardCents  BigInt      @map("estimated_reward_cents")
  // Reach the estimate was built on (real averageReach from past shares or the
  // story-views fallback). Surfaced to the customer as "your story needs ~N
  // views to earn this much". Nullable for back-compat with existing rows.
  estimatedAverageReach Int?        @map("estimated_average_reach")
  finalPrice            FinalPrice? // the algo-calculations for final price - multiplers etc. -> not source of truth. use ledger as source of truth

  // Quality rating as half-stars: 1–10 = ½★–5★ (divide by 2), null = unrated.
  // Replaced the old `Rating` enum column (EXCEPTIONAL/GOOD/BAD/UNRATED/REPORTED);
  // the migration mapped existing rows to stars. The legacy enum survives only on
  // the v1 wire (old builds): controllers map enum→stars on input and stars→enum
  // on output via ratingEnum↔Stars (@tagly/models). "Reported" is NOT a rating —
  // it lives on the ShareReport row + the derived status.
  rating  Int?
  report  ShareReport?
  // INVARIANT: `ratedAt` is the canonical "advertiser/admin has acted on this share"
  // marker. It is stamped the moment the share is first acted on — whether RATED or
  // REPORTED — and from then on is PRESERVED, never reset and never cleared; share
  // creation leaves it null. Every write that touches it keeps the original via
  // `share.ratedAt ?? now`: rateShareByUid, reportShareByUid, adminRateShare (rate or
  // report), and adminReviewShareReport's dismiss-with-rating (which preserves the
  // report-filing timestamp rather than re-stamping). The uphold branch doesn't write
  // it at all (the report it reviews was already filed → already stamped). Keeping the
  // original value also anchors the rating-change window to the first action.
  // Therefore `ratedAt IS NULL` ⟺ the share is UNRATED *and* UNREPORTED, and that is
  // the single condition the "unrated / rate-me" queues filter on (a report counts
  // as having acted). Equivalently: a report row always implies `ratedAt` is set.
  ratedAt DateTime?    @map("rated_at") @db.Timestamptz(3)

  forceCreated Boolean?    @map("force_created")
  status       ShareStatus @default(PROCESSING)
  paidAt       DateTime?   @map("paid_at") @db.Timestamptz(3)

  // Admin moderation gate (see ShareApprovalStatus). New shares are PENDING and
  // stay fully hidden from the advertiser (no lock, no notification, excluded
  // from every advertiser query/stat) until an admin approves. Existing rows
  // were backfilled to APPROVED. The lock is placed and `a.shares.created` sent
  // only at approval; rejection lives ONLY here (`status` stays PROCESSING).
  approvalStatus    ShareApprovalStatus @default(PENDING) @map("approval_status")
  reviewedAt        DateTime?           @map("reviewed_at") @db.Timestamptz(3)
  reviewedByAdminId Int?                @map("reviewed_by_admin_id")
  rejectionReason   String?             @map("rejection_reason")

  // Immutable funding classification, stamped once at creation (no default —
  // every creation path must classify explicitly). `=== SUBSIDIZED` is the
  // canonical subsidized-at-creation signal used at settlement. The *actual*
  // funding outcome at settlement is derivable from the ledger and is
  // deliberately NOT denormalized here.
  fundingModeAtCreation ShareFundingMode @map("funding_mode_at_creation")

  // Settlement retry bookkeeping. `paygChargeAttempts` is null until the first
  // card charge attempt (meaningless for credits/subsidized shares).
  // `paygNextRetryAt` is — despite the name — the GENERIC settle-retry gate the
  // payment worker checks for EVERY share: set by PAYG charge declines/deferred
  // retries AND by transient (non-domain) settle errors on any funding mode.
  paygChargeAttempts    Int?      @map("payg_charge_attempts")
  paygNextRetryAt       DateTime? @map("payg_next_retry_at") @db.Timestamptz(3)
  stripePaymentIntentId String?   @map("stripe_payment_intent_id")

  // Why the share was voided to UNPAYABLE — the USER-FACING classification, a
  // `ShareVoidReason` slug from @tagly/models (IG_DISCONNECTED / IG_DATA_DELETED /
  // ACCOUNT_DELETED / INSIGHTS_UNAVAILABLE / SETTLEMENT_FAILED). Written ONLY by
  // `markShareUnpayableAndUnlock` (the single UNPAYABLE writer), surfaced on the
  // v2 customer + advertiser share details where clients render localized copy.
  // Plain String like FinalPrice.capReason (the Zod enum is the contract; a DB
  // enum would add a migration per new slug). Null on pre-column voids →
  // clients fall back to generic copy. The technical detail stays in
  // `lastProcessingError` below (admin-only).
  voidReason String? @map("void_reason")

  // Why this share was last marked UNPAYABLE (or last failed to settle) — recorded
  // at every site that sets that status: the igInsights / igSnapshot / sharePayment
  // workers, the maintenance expiry sweep, and customer/advertiser account deletion,
  // plus the PAYG deferred-retry path. Lets admins see WHY without grepping logs.
  // Reflects the most recent reason; persisted even after an eventual success.
  // Currently-broken shares are `status = UNPAYABLE` (terminal) or have
  // `paygNextRetryAt` set (settle retry pending — PAYG or transient error).
  lastProcessingError   String?   @map("last_processing_error")
  lastProcessingErrorAt DateTime? @map("last_processing_error_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  thumbnail Media? @relation("ShareThumbMedia", fields: [thumbnailId], references: [id], onDelete: Restrict)
  media     Media  @relation("ShareMainMedia", fields: [mediaId], references: [id], onDelete: Restrict)

  advertiser Advertiser?      @relation(fields: [advertiserId], references: [id], onDelete: SetNull)
  customer   Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  local      LocalSubaccount? @relation(fields: [localId], references: [id], onDelete: SetNull)

  insights               ShareInsights?
  instagramInsightsQueue InstagramInsightsQueue?
  instagramSnapshot      InstagramSnapshot?
  instagramSnapshotQueue InstagramSnapshotQueue?

  ledgerEvents TransactionLedgerEvent[] @relation("LedgerShare")

  @@index([advertiserId, status])
  @@index([localId, status])
  @@index([status, createdAt])
  @@index([mediaId])
  @@index([advertiserId, createdAt])
  @@index([customerId, createdAt])
  @@index([localId])
  @@index([igPostId])
  @@index([uid])
  // Admin pending-approval queue + the payment worker's approval gate.
  @@index([approvalStatus, createdAt])
  // Advertiser-facing reads now filter advertiserId + approvalStatus = APPROVED.
  @@index([advertiserId, approvalStatus])
  @@map("shares")
  @@schema("app")
}

model InstagramSnapshot {
  id      Int    @id @default(autoincrement())
  shareId Int?   @unique @map("share_id")
  share   Share? @relation(fields: [shareId], references: [id], onDelete: Cascade)

  instagramId Int                      @map("instagram_id")
  instagram   CustomerInstagramAccount @relation(fields: [instagramId], references: [id], onDelete: Cascade)

  followerCount  Int  @map("follower_count")
  // Accounts the customer follows, at capture time. Nullable: older snapshots
  // never captured it, and IG may omit `follows_count` for some accounts.
  // Not a display stat (the account row has no copy) — kept only as frozen
  // per-snapshot audience data for potential quality signals.
  followingCount Int? @map("following_count")

  // The audience-location source CHOSEN for this snapshot at capture time
  // (guards in constants/instagram/AUDIENCE_CAPTURE.ts). NULL = the
  // snapshot captured no audience locations at all (e.g. <100 followers — IG
  // suppresses the breakdowns). Follower rows are always stored when available
  // (the frozen v1 pricer reads them); reached rows are stored in addition only
  // when REACHED_AUDIENCE wins. Consumers read the rows matching THIS source.
  audienceLocationsSource     AudienceLocationSource? @map("audience_locations_source")
  // True breakdown sum of the chosen source (pre-cap, straight from IG).
  audienceLocationsTotalValue Int                     @default(0) @map("audience_locations_total_value")
  audienceGenderAgeTotalValue Int                     @default(0) @map("audience_gender_age_total_value")

  audienceLocations  InstagramAudienceLocation[]
  audienceGenderAges InstagramAudienceGenderAge[]

  snapshotTakenAt DateTime @map("snapshot_taken_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([shareId])
  @@index([instagramId])
  @@index([instagramId, snapshotTakenAt])
  @@index([createdAt])
  @@map("instagram_snapshots")
  @@schema("app")
}

model FinalPrice {
  shareId Int   @id @map("share_id")
  share   Share @relation(fields: [shareId], references: [id], onDelete: Cascade)

  // Meta
  /// The RELEASE that priced this row — the backend package.json version at the
  /// time the pricing pipeline last changed (e.g. "2.0.2"), NOT a counter. Rows
  /// written before algo v12 hold the old integer scheme as text ("1".."12").
  /// Bumping the pricing algo REQUIRES bumping tagly-backend/package.json, so a
  /// stored value always checks out to code you can read.
  algoVersion String @map("algo_version") @db.VarChar(32)
  currency    String @db.VarChar(3)

  // money in cents, all in `currency`
  qualifiedReach Int    @map("qualified_reach") // quality (exit rate etc) * reach
  ecpmCents      BigInt @map("ecpm_cents") // eCPM used (cents per 1k qr)
  baseValueCents BigInt @map("base_value_cents") // (QR/1000 * eCPM)

  // Action bonuses (AFTER caps & viral dampen), added to base BEFORE multipliers
  actionBonusesCents BigInt @map("action_bonuses_cents")

  // Multipliers (unitless results only)
  geoMultiplierBps               Int  @map("geo_multiplier_bps")
  demoMultiplierBps              Int  @map("demo_multiplier_bps")
  interestMultiplierBps          Int  @map("interest_multiplier_bps")
  ratingMultiplierBps            Int  @map("rating_multiplier_bps")
  frequencyMultiplierBps         Int  @map("frequency_multiplier_bps")
  audienceRelevanceMultiplierBps Int  @map("audience_relevance_multiplier_bps") // account size / virality
  // Follower:following ratio penalty (decrease-only). Nullable: not tracked on
  // pre-existing rows, and only the v2 pricer computes it — v1-settled rows are
  // NULL. 10_000 = neutral (no penalty).
  accountQualityMultiplierBps    Int? @map("account_quality_multiplier_bps")
  // Business-type multiplier (`rewardMultiplierBps`: the type's catalog
  // override, else its primary vertical's value — e.g. the cafe discount). Nullable: rows settled before the multiplier was
  // wired into the pricer (algo v11) priced it as 1.0x and store NULL.
  typeMultiplierBps              Int? @map("type_multiplier_bps")

  // Cap + take audit fields. Nullable because they weren't tracked on
  // pre-existing FinalPrice rows. New rows always populate all three, so
  // audit queries can filter with `WHERE subtotal_before_cap_cents IS NOT NULL`.
  //
  // Reconstruction of finalPriceCents:
  //   wasSubsidized    = SubsidizationPeriod overlap on share.createdAt
  //   subtotalAfterCap = applySharePriceCap(subtotalBeforeCap, wasSubsidized)  ← also stored
  //   finalPrice       = subtotalAfterCap
  //                      × (wasSubsidized ? (1 - TAGLY_PLATFORM_TAKE_BPS) : 1)
  //                      × countryMultiplierBps / 10_000
  //
  // `wasSubsidizedAtCreation` and `priceCapCents` are deliberately not stored
  // — both are derivable. `wasSubsidized` comes from the SubsidizationPeriod
  // overlap (canonical per CLAUDE.md §Subsidized Share Invariant); the cap
  // value comes from MAX_SHARE_PRICE_CENTS / SUBSIDIZED.MAX_PRICE_RATIO
  // constants locked to the `algoVersion` recorded on the row.
  //
  // `subtotalBeforeCap` is irreducible (the cap is one-way). `subtotalAfterCap`
  // is also stored so the pipeline reads linearly — cap → multiplier — and
  // "did the cap kick?" is a one-line comparison.
  subtotalBeforeCapCents BigInt? @map("subtotal_before_cap_cents") // post-multipliers, pre-cap
  subtotalAfterCapCents  BigInt? @map("subtotal_after_cap_cents") // output of applySharePriceCap
  countryMultiplierBps   Int?    @map("country_multiplier_bps") // PR 4: post-take country scaling (US=10000, CZ=5750)

  finalPriceCents BigInt @map("final_price_cents") // in currency

  // Settlement outcome vs the algo price. `finalPriceCents` is what the algo
  // computed the share was worth; the gross actually collected at settlement can
  // be less when the budget couldn't cover it. Both are nullable — populated
  // only by the settle-time update (older rows and not-yet-settled rows are
  // NULL). `settledGrossCents` = the gross actually collected (customer paid 60%
  // of it). `capReason` explains why it was short, null = paid in full:
  //   - "LOW_BUDGET"        partial lock (SHARE_LOCK meta `cappedAtAvailableBudget`)
  //   - "OVER_LOCK"         full lock, but algo final exceeded lock + available
  //   - "PLATFORM_BALANCE"  subsidized, platform Stripe balance was short
  settledGrossCents BigInt? @map("settled_gross_cents")
  capReason         String? @map("cap_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("final_price")
  @@schema("app")
}

// Unified per-share Instagram insights (1:1 with Share). Replaces the former
// ig_story/post/reel_insights tables. Which metrics are populated depends on the
// share's media type — read `share.igPostType` (STORY | POST | REEL) as the
// discriminator. It's the authoritative source: the igInsights worker switches
// on it to choose which IG endpoint to fetch and refuses any other value, so a
// share that has an insights row always has a valid igPostType. All metric
// columns are nullable (IG returns them best-effort); fields not applicable to a
// given type stay NULL (e.g. tapsForward only on STORY, igReelsAvgWatchTime on REEL).
model ShareInsights {
  shareId Int   @id @map("share_id")
  share   Share @relation(fields: [shareId], references: [id], onDelete: Cascade)

  // shared across types
  reach             Int?
  views             Int?
  shares            Int?
  totalInteractions Int? @map("total_interactions")
  follows           Int? // STORY, POST
  profileVisits     Int? @map("profile_visits") // STORY, POST
  comments          Int? // POST, REEL
  likes             Int? // POST, REEL
  saved             Int? // POST, REEL

  // STORY-only
  replies     Int?
  tapsForward Int? @map("taps_forward") // from "navigation"
  tapsBack    Int? @map("taps_back") // from "navigation"
  exits       Int? // from "navigation"

  // REEL-only
  igReelsAvgWatchTime Int? @map("ig_reels_avg_watch_time")

  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("share_insights")
