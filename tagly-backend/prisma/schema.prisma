// Audit episode of when an advertiser had pay-as-you-go active. Mirrors
// SubsidizationPeriod. Invariant (enforced in app logic): at most one open
// period (ended_at IS NULL) per advertiser. Opened when PAYG is enabled with a
// card on file; closed on disable, card removal, or a failed charge (the last
// is how "pause" is represented). Settings (cap, mandate) live on the
// advertiser, not here, so they survive on/off toggles.
model PaygPeriod {
  id           Int                  @id @default(autoincrement())
  advertiserId Int                  @map("advertiser_id")
  advertiser   Advertiser           @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  startedAt    DateTime             @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt      DateTime?            @map("ended_at") @db.Timestamptz(3)
  endedReason  PaygPeriodEndReason? @map("ended_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([advertiserId])
  @@map("payg_periods")
  @@schema("app")
}

enum PaygPeriodEndReason {
  CARD_REMOVED // card detached (triggers convert-to-locked-credits)
  CHARGE_FAILED // a settlement charge declined — this is the "pause"
  DISABLED // the advertiser turned PAYG off while keeping the saved card

  @@schema("app")
}

// Audit episode of when an advertiser had the monthly-budget top-up active AT
// A GIVEN TARGET. Mirrors PaygPeriod: at most one open period (ended_at IS
// NULL) per advertiser (partial unique index
// `monthly_budget_periods_one_open_per_advertiser`). A period is IMMUTABLE
// once opened: changing the target closes it (TARGET_CHANGED) and opens a new
// one, so the period list IS the target history. Opened when the monthly
// budget is enabled (or re-targeted) with a saved card on file — and the new
// period tops up to its target immediately; closed on disable, re-target, card
// removal, or a charge declined past MAX_ATTEMPTS (the "pause").
// Unlike PAYG, the run bookkeeping lives HERE (not on a share): the stripe
// worker polls next_run_at and tops the advertiser's credits up to
// target_cents on the 1st of each month (CHARGE_HOUR_UTC). Because a period is
// immutable and each open tops up at once, a period runs AT MOST ONCE PER
// CALENDAR MONTH — which is what lets the charge idempotency key be
// `monthly-budget:{YYYY-MM}:{periodId}:attempt:{n}` with no run counter.
model MonthlyBudgetPeriod {
  id           Int        @id @default(autoincrement())
  advertiserId Int        @map("advertiser_id")
  advertiser   Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  // The level the advertiser's available credits are restored to. Write-once:
  // a different target is a new period.
  targetCents BigInt @map("target_cents")

  // When the next top-up is due — the single scheduling truth and the stripe
  // worker's poll key (open periods only). `now` on open (the period tops up
  // immediately), the 1st of next month at CHARGE_HOUR_UTC after every terminal
  // outcome (charged or skipped), `now + backoff` after a decline, `now + a
  // short recheck` after an ambiguous Stripe answer. Kept on close (audit).
  nextRunAt DateTime? @map("next_run_at") @db.Timestamptz(3)

  // Declines spent on the current month's charge; reset to 0 on a terminal
  // outcome. Feeds the retry backoff and the idempotency key's attempt number.
  chargeAttempts Int @default(0) @map("charge_attempts")

  // The charge identity of the attempt currently in flight — the Stripe
  // idempotency key AND the StripeCreditPurchase.externalRef. Set when an
  // attempt mints one, REUSED while that attempt is unresolved, cleared on
  // every terminal outcome (charged / skipped / declined).
  //
  // It is remembered rather than recomputed because the key embeds the run's
  // UTC month: an ambiguous Stripe answer (1342) reschedules a recheck, and if
  // that recheck lands in the next month a recomputed key would differ from the
  // one the maybe-collected charge was placed under — the pre-check would miss
  // it and charge a second time. Recomputing can also not be repaired by a
  // month-blind lookup: `chargeAttempts` resets each month, so
  // (periodId, attempt) alone matches LAST month's charge too.
  currentAttemptRef String? @map("current_attempt_ref")

  // Last decline detail, for the CARD_FAILED copy in the app + admin.
  lastFailureCode    String? @map("last_failure_code")
  lastFailureMessage String? @map("last_failure_message")

  // When the advertiser was last emailed the "upcoming charge" notice (sent
  // ~3 days before nextRunAt). A notice is due when this is null or predates
  // the current run's notice window. A column rather than a queue dedupe key
  // because finished NotificationQueue rows are pruned after 24h, shorter than
  // the notice window.
  upcomingNoticeSentAt DateTime? @map("upcoming_notice_sent_at") @db.Timestamptz(3)

  startedAt   DateTime                      @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt     DateTime?                     @map("ended_at") @db.Timestamptz(3)
  endedReason MonthlyBudgetPeriodEndReason? @map("ended_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([advertiserId])
  @@index([nextRunAt])
  @@map("monthly_budget_periods")
  @@schema("app")
}

enum MonthlyBudgetPeriodEndReason {
  DISABLED // the advertiser turned it off
  TARGET_CHANGED // superseded by a new period at a different target
  CARD_REMOVED // saved card detached
  CHARGE_FAILED // declined past MAX_ATTEMPTS — this is the "pause"

  @@schema("app")
}

