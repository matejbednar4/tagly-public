enum ReportType {
  NOT_PROMOTION
  MISLEADING_LOCATION
  INAPPROPRIATE
  DUPLICATE
  VIOLATES_GUIDELINES
  CUSTOMER_NOT_SPENT_MONEY

  @@schema("app")
}

