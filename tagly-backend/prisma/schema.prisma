model AdvertiserSensitiveData {
  id Int @id @default(autoincrement())

  // Per-currency budget accumulators. See note on CustomerSensitiveData for
  // the design rationale (additive multi-currency).
  availableBudgetUsdCents      BigInt  @default(0) @map("available_budget_usd_cents")
  lockedBudgetUsdCents         BigInt  @default(0) @map("locked_budget_usd_cents")
  // NOTE: there is deliberately NO lifetime-purchases accumulator here. Lifetime
  // credit purchases are derived on read from the ledger (kind = CREDIT_PURCHASE
  // only — see `utils/money/ledger/advertiserCreditPurchases.ts`), the same
  // way total withdrawals are. The ledger is the single money source of truth;
  // a denormalized counter was a second source that could only drift from it.
  stripeCustomerId             String? @unique @map("stripe_customer_id")
  defaultPaymentMethodId       String? @map("default_payment_method_id")

  // The account's saved off-session card — linked under a Stripe off-session
  // SetupIntent (MIT mandate), so it CAN be charged without the advertiser
  // present. The SOURCE OF TRUTH for "a card is on file", shared by the two
  // features that charge it: pay-as-you-go settlement and the monthly-budget
  // top-up. Whether each feature is ON is tracked separately by its period
  // model (PaygPeriod / MonthlyBudgetPeriod) — a card on file does not by
  // itself enable either. Distinct from `defaultPaymentMethodId` (which a
  // one-off credit purchase also sets, on-session, with no MIT mandate — so it
  // can't be charged off-session). Written only by `linkSavedCard` (via the
  // reconcile endpoints + the SetupIntent webhook); cleared on unlink, which
  // closes BOTH feature periods in the same transaction.
  // Card brand/last4 are NOT stored — fetched live from Stripe on demand when
  // the advertiser asks to see the card.
  // (Renamed from paygPaymentMethodId when monthly budget landed; the DB rename
  // was an in-place RENAME COLUMN, no data movement.)
  savedPaymentMethodId    String?   @map("saved_payment_method_id")
  // NOTE: the PAYG monthly spend cap column was dropped — PAYG has no cap. The v1
  // wire still returns `monthlySpendCapCents: null` (a constant) for old clients;
  // the v1 set-cap endpoint is a no-op. Nothing persists a cap anymore.
  // When the advertiser explicitly authorized Tagly to charge their card
  // off-session (the Stripe MIT mandate consent, covering both PAYG and
  // monthly-budget charges). Captured at setup-intent time, before the sheet
  // opens. Durable and card-independent — kept on card removal since it records
  // the authorisation act, not the card state.
  // (Renamed from paygChargeAuthorizedAt when monthly budget landed.)
  offSessionChargeAuthorizedAt DateTime? @map("off_session_charge_authorized_at") @db.Timestamptz(3)

  advertiser Advertiser? @relation(name: "AdvertiserToSensitive")

  @@index([stripeCustomerId])
  @@map("advertiser_sensitive_data")
  @@schema("app")
}

