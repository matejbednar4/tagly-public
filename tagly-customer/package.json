{
  "name": "tagly-customer",
  "description": "Tagly customer app (Expo/React Native)",
  "version": "2.0.2",
  "author": "Flaer, Inc.",
  "dependencies": {
    "@babel/runtime": "^7.27.6",
    "@tagly/client": "2.0.2",
    "@tagly/models": "2.0.2",
    "@tagly/sdk": "2.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@tanstack/react-query": "^5.87.0",
    "eas-cli": "^16.28.0",
    "expo": "54.0.25",
    "expo-apple-authentication": "~8.0.8",
    "expo-application": "~7.0.8",
    "expo-asset": "12.0.10",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "~7.0.8",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.9",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.13",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.8",
    "expo-image-manipulator": "~14.0.7",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "^15.0.8",
    "expo-linking": "~8.0.10",
    "expo-localization": "~17.0.8",
    "expo-location": "~19.0.7",
    "expo-mail-composer": "~15.0.7",
    "expo-notifications": "~0.32.12",
    "expo-router": "~6.0.17",
    "expo-secure-store": "~15.0.7",
    "expo-sharing": "~14.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-store-review": "^9.0.9",
    "expo-updates": "~29.0.12",
    "expo-web-browser": "~15.0.8",
    "i18next": "^24.2.0",
    "lodash": "^4.17.21",
    "lucide-react-native": "^0.562.0",
    "pdf-lib": "^1.17.1",
    "posthog-react-native": "^4.37.2",
    "react": "19.1.0",
    "react-i18next": "^15.5.0",
    "react-native": "0.81.5",
    "react-native-appsflyer": "^6.17.7",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-controller": "1.22.2",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-image-crop-picker": "^0.51.0",
    "react-native-maps": "1.20.1",
    "react-native-permissions": "^5.4.1",
    "react-native-qrcode-styled": "^0.4.0",
    "react-native-reanimated": "4.1.2",
    "react-native-safe-area-context": "5.6.1",
    "react-native-screens": "4.16.0",
    "react-native-share": "^12.2.0",
    "react-native-svg": "15.12.1",
    "react-native-toast-message": "^2.3.0",
    "react-native-video": "^6.14.0",
    "react-native-view-shot": "^4.0.3",
    "react-native-webview": "^13.12.5",
    "react-native-worklets": "0.5.1",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "^13.5.2",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.16",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.0.0",
    "@types/tz-lookup": "^6.1.2",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "^54.0.14",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?expo|@expo(|/.*)|react-native|react-native-.*|@react-native(|-community)/.*|@tanstack/.*|@tagly/models|@tagly/sdk|@tagly/client))"
    ]
  },
  "license": "UNLICENSED",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "android:dev": "expo run:android",
    "ios:dev": "expo run:ios -d",
    "start:dev": "expo start --dev-client -c --scheme com.flaer.customer.dev --port 8081",
    "start:staging": "expo start --dev-client -c --scheme com.flaer.customer.staging --port 8081",
    "build:staging": "eas build -p ios --profile staging",
    "submit:staging": "eas submit -p ios --latest --profile staging",
    "build:android:staging": "eas build -p android --profile staging-android",
    "submit:android:staging": "eas submit -p android --latest --profile staging-android",
    "build:android:prod": "eas build -p android --profile production",
    "submit:android:prod": "eas submit -p android --latest --profile production",
    "actions:build:staging": "npx eas-cli build -p ios --profile staging --non-interactive",
    "actions:submit:staging": "npx eas-cli submit -p ios --latest --profile staging --non-interactive",
    "actions:build:android:staging": "npx eas-cli build -p android --profile staging-android --non-interactive",
    "actions:submit:android:staging": "APP_ENV=staging npx eas-cli submit -p android --latest --profile staging-android --non-interactive",
    "actions:build:prod": "npx eas-cli build -p ios --profile production --non-interactive",
    "actions:submit:prod": "npx eas-cli submit -p ios --latest --profile production --non-interactive",
    "actions:build:android:prod": "npx eas-cli build -p android --profile production --non-interactive",
    "actions:submit:android:prod": "APP_ENV=production npx eas-cli submit -p android --latest --profile production --non-interactive",
    "android": "expo run:android",
    "ios": "expo run:ios"
  }
}
