{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "jsx": "react-native",
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["expo", "react", "react-native", "jest"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "expo-env.d.ts",
    "app.config.ts",
    ".expo/types/**/*.ts", "../tagly-shared/client/components/drawer/SlideInDrawer.tsx",
  ],
  "exclude": ["node_modules", "dist"]
}
